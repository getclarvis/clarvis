{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": [
        "tooling/checks/**/*.ts",
        "tooling/release/**/*.ts",
        "tooling/runtime/**/*.ts",
        "tooling/test-runtime/**/*.ts"
      ],
      "project": ["*.js", "tooling/**/*.{ts,js}"]
    },
    "packages/code": {
      "entry": ["tooling/**/*.ts", "tooling/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "tooling/**/*.{ts,tsx}"]
    },
    "packages/kernel": {
      "entry": ["src/bin.ts", "tests/helpers/capability-executable-fixture.ts"]
    },
    "packages/protocol": {
      "entry": ["tests/contract/public-contract.fixture.ts"]
    },
    "packages/tools": {
      "ignoreBinaries": ["rg"]
    }
  }
}
