{
  "name": "@clarvis/judge",
  "private": true,
  "description": "Isolated semantic assessment of execution approvals.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "bun -e \"await import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true, force:true}))\"",
    "test": "bun test tests/unit --timeout 60000",
    "test:unit": "bun test tests/unit --timeout 60000",
    "test:coverage": "bun test tests/unit --timeout 60000 --coverage",
    "eval": "bun run ../../tooling/judge/eval.ts",
    "eval:business": "bun run ../../tooling/judge/eval.ts --business",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@clarvis/capability": "workspace:*"
  }
}
