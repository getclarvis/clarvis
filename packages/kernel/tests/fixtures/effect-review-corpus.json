{
  "version": 1,
  "shell_human_only": [
    "git $SUBCOMMAND",
    "$(cat command)",
    "git commit -m \"$(cat message.txt)\"",
    "git commit -m \"$(cat <<EOF\n$MESSAGE\nEOF\n)\"",
    "git commit -m $(cat <<'EOF'\n--amend\nEOF\n)",
    "git commit -m \"$(cat -n <<'EOF'\nmessage\nEOF\n)\"",
    "git commit -m \"$(cat <<'EOF' >output\nmessage\nEOF\n)\"",
    "git commit -m \"unbalanced",
    "export TMPDIR=$ROOT; git status",
    "export UNKNOWN=/tmp; git status",
    "env git status",
    "eval 'git status'",
    "source script.sh",
    "xargs git status",
    "base64 payload",
    "sh -c 'git status'",
    "bash -c 'git status'",
    "git status > $OUTPUT",
    "git status | cat",
    "gh run rerun 42 --repo other/repo --failed",
    "gh run rerun 42 --repo owner/repo --failed --unknown",
    "gh run rerun 42 --repo owner/repo",
    "gh workflow run arbitrary",
    "gh pr merge 7 --admin",
    "git push --force origin HEAD",
    "git tag release",
    "gh release create release",
    "deploy publish production",
    "rm -rf data",
    "cat ~/.ssh/id_ed25519"
  ],
  "execution_environment": [
    "LD_PRELOAD=/evil.so",
    "LD_LIBRARY_PATH=/evil",
    "DYLD_INSERT_LIBRARIES=/evil.so",
    "NODE_OPTIONS=--inspect",
    "BASH_ENV=/evil",
    "ENV=/evil",
    "PYTHONPATH=/evil",
    "RUBYOPT=-r/evil",
    "GIT_SSH_COMMAND=evil"
  ],
  "protected_paths": [
    ".clarvis/settings.json",
    ".clarvis/guard-judge.md",
    ".clarvis/runtime/script.sh",
    ".agents/settings.json",
    ".env",
    ".env.production",
    ".git/config",
    "package.json",
    "Dockerfile",
    "id_ed25519",
    "certificate.pem"
  ],
  "non_operator_sources": [
    "assistant",
    "skill",
    "manager",
    "brief",
    "command",
    "justification",
    "tool",
    "AGENTS.md",
    "CLARVIS.md"
  ]
}
