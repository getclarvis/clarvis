{
  "compilerOptions": {
    "types": ["bun", "node"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "customConditions": ["bun"],
    "verbatimModuleSyntax": true,

    "lib": ["ESNext"]
  },
  "include": ["src", "tests"]
}
