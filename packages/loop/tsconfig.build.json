{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "paths": {}
  },
  "references": [
    {
      "path": "../capability/tsconfig.build.json"
    },
    {
      "path": "../llm/tsconfig.build.json"
    },
    {
      "path": "../paths/tsconfig.build.json"
    },
    {
      "path": "../supervision/tsconfig.build.json"
    },
    {
      "path": "../trace/tsconfig.build.json"
    },
    {
      "path": "../mcp-client/tsconfig.build.json"
    },
    {
      "path": "../tools/tsconfig.build.json"
    },
    {
      "path": "../hooks/tsconfig.build.json"
    },
    {
      "path": "../skills/tsconfig.build.json"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
