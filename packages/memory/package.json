{
  "name": "@clarvis/memory",

  "private": true,
  "description": "Workspace-local execution memory for Clarvis agents \u2014 a navigable markdown wiki (PROFILE \u2192 TOPIC \u2192 MEMORY) the model reads and edits directly, with a deterministic reindex and an autonomous per-run indexer that runs as a real agent run over those same tools.",
  "license": "MIT",
  "keywords": [
    "llm",
    "agent",
    "ai-agent",
    "coding-agent",
    "memory",
    "long-term-memory",
    "markdown",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "bun": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./capability": {
      "bun": "./src/capability.ts",
      "types": "./dist/capability.d.ts",
      "import": "./dist/capability.js"
    },
    "./settings": {
      "bun": "./src/settings.ts",
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "bun -e \"await import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true, force:true}))\"",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test tests/unit --timeout 60000",
    "test:component": "bun test tests/component --timeout 60000",
    "test:contract": "bun test tests/contract --timeout 60000",
    "test:integration": "bun test tests/integration --timeout 60000",
    "test:architecture": "bun test tests/architecture --timeout 60000",
    "test:coverage": "bun test --timeout 60000 --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@clarvis/capability": "workspace:*",
    "@clarvis/loop": "workspace:*",
    "@clarvis/paths": "workspace:*",
    "zod": "^4.4.3"
  }
}
