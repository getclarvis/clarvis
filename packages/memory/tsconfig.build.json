{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "paths": {}
  },
  "references": [
    {
      "path": "../capability/tsconfig.build.json"
    },
    {
      "path": "../loop/tsconfig.build.json"
    },
    {
      "path": "../paths/tsconfig.build.json"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
