{
  "name": "@clarvis/plan",

  "private": true,
  "description": "Provider-neutral execution plans and Markdown persistence for Clarvis.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "bun": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json",
    "./capability": {
      "bun": "./src/capability/index.ts",
      "types": "./dist/capability/index.d.ts",
      "import": "./dist/capability/index.js"
    },
    "./settings": {
      "bun": "./src/settings.ts",
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "bun -e \"await import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true, force:true}))\"",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test tests/unit --timeout 60000",
    "test:component": "bun test tests/component --timeout 60000",
    "test:contract": "bun test tests/contract --timeout 60000",
    "test:integration": "bun test tests/integration --timeout 60000",
    "test:architecture": "bun test tests/architecture --timeout 60000",
    "test:coverage": "bun test --timeout 60000 --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@clarvis/capability": "workspace:*",
    "@clarvis/paths": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
