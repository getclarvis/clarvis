{
  "name": "@clarvis/sandbox",
  "private": true,
  "description": "Native process isolation policy and launch backends for Clarvis tools.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "native",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && bun run build:assets",
    "build:assets": "bun tooling/build-native.ts",
    "clean": "bun -e \"await import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true, force:true}))\"",
    "test": "bun run test:integration",
    "test:native": "bun test tests/integration/native --timeout 60000",
    "test:coverage": "bun test tests/integration --timeout 60000 --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "test:integration": "bun test tests/integration/common --timeout 60000"
  },
  "dependencies": {
    "@clarvis/paths": "workspace:*"
  }
}
