{
  "name": "@clarvis/tasks",

  "private": true,
  "description": "Provider-neutral external task management for Clarvis.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capability": {
      "bun": "./src/capability.ts",
      "types": "./dist/capability.d.ts",
      "import": "./dist/capability.js"
    },
    "./settings": {
      "bun": "./src/settings.ts",
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./testing": {
      "bun": "./src/testing/provider-conformance.ts",
      "types": "./dist/testing/provider-conformance.d.ts",
      "import": "./dist/testing/provider-conformance.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "bun -e \"await import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true, force:true}))\"",
    "test": "bun test tests/unit tests/component tests/architecture --timeout 60000",
    "test:unit": "bun test tests/unit --timeout 60000",
    "test:component": "bun test tests/component --timeout 60000",
    "test:architecture": "bun test tests/architecture --timeout 60000",
    "test:coverage": "bun test tests/unit tests/component --timeout 60000 --coverage && bun run test:architecture",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@clarvis/capability": "workspace:*",
    "zod": "^4.4.3"
  }
}
