{
  "name": "@clarvis/tools",
  "private": true,
  "description": "A minimal, opinionated set of coding tools for driving an LLM agent over a workspace \u2014 file reads, writes, edits, patches, and run-owned shell sessions \u2014 usable as a plain library.",
  "license": "MIT",
  "keywords": [
    "llm",
    "agent",
    "ai-agent",
    "coding-agent",
    "tools",
    "tool-use",
    "coding-tools",
    "filesystem",
    "apply-patch",
    "shell",
    "workspace",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell": {
      "bun": "./src/shell-entry.ts",
      "types": "./dist/shell-entry.d.ts",
      "import": "./dist/shell-entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["src", "assets", "README.md"],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && bun run build:assets",
    "build:assets": "bun tooling/build-worker.ts",
    "clean": "bun -e \"await import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true, force:true}))\"",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test tests/unit --timeout 60000",
    "test:component": "bun test tests/component --timeout 60000",
    "test:contract": "bun test tests/contract --timeout 60000",
    "test:integration": "bun test tests/integration --timeout 60000",
    "test:native": "CLARVIS_NATIVE_SANDBOX_TEST=1 bun test tests/integration/native-sandbox.test.ts --timeout 60000",
    "test:architecture": "bun test tests/architecture --timeout 60000",
    "test:coverage": "CLARVIS_NATIVE_SANDBOX_TEST=1 bun test --timeout 60000 --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\""
  },
  "dependencies": {
    "@clarvis/paths": "workspace:*",
    "ajv": "^8.20.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@clarvis/sandbox": "workspace:*"
  }
}
